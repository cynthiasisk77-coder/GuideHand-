{
  "expo": {
    "name": "GuideHand",
    "slug": "guidehand-emergency-preparedness-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "emergencyprepapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.guidehand.emergencyprep",
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.guidehand.emergencyprep",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a",
              "armeabi-v7a"
            ]
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "GuideHand uses your photo library so you can save pictures of important documents (ID, insurance, deeds) for quick offline access.",
          "cameraPermission": "GuideHand uses your camera so you can photograph important documents (ID, insurance, deeds) for quick offline access."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "GuideHand uses your camera to scan a meeting-place code from another persons phone, so you can both save the same spot without any network.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "GuideHand uses your location so it can tell you how far you are from your family meeting place. Your location stays on this device and is never sent anywhere.",
          "locationWhenInUsePermission": "GuideHand uses your location so it can tell you how far you are from your family meeting place. Your location stays on this device and is never sent anywhere.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      "expo-secure-store",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0d85659e-59ab-4cbd-8cf3-a4b0812d5359"
      }
    },
    "owner": "your-ancestors-medicine-cabinet",
    "updates": {
      "url": "https://u.expo.dev/0d85659e-59ab-4cbd-8cf3-a4b0812d5359"
    },
    "runtimeVersion": "exposdk:57.0.0"
  }
}
