{
  "expo": {
    "name": "GuideHand",
    "slug": "guidehand-emergency-preparedness-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "emergencyprepapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.guidehand.emergencyprep",
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.guidehand.emergencyprep",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0d85659e-59ab-4cbd-8cf3-a4b0812d5359"
      }
    },
    "owner": "guidehand_emergency-app",
    "updates": {
      "url": "https://u.expo.dev/0d85659e-59ab-4cbd-8cf3-a4b0812d5359"
    },
    "runtimeVersion": "exposdk:57.0.0"
  }
}
